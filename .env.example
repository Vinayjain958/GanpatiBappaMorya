# ==============================================================================
# LocaLens — Environment Variable Contract
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# The application should start in local development even when most values are
# absent — missing optional services will fall back to mock adapters.
# ==============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production

APP_SECRET_KEY=
# Required in production. Used for session signing.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./localens_dev.db
# Local development default: SQLite (async).
# Production: postgresql+asyncpg://user:password@host:5432/localens

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
GEMINI_API_KEY=
# Required for AI features. Never expose in client/browser code.
# The API backend issues short-lived ephemeral tokens to the browser
# for Gemini Live sessions; the master key remains server-side only.

GEMINI_MODEL_TEXT=gemini-2.0-flash
# Default text/reasoning model. Override for experiments.

GEMINI_MODEL_LIVE=gemini-2.0-flash-live-001
# Model used for Gemini Live voice sessions.

# ─── Maps & Location ──────────────────────────────────────────────────────────
# No key required for OSM/Nominatim/OSRM in development (rate limits apply).
# Set a custom Nominatim URL if you run a self-hosted instance.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# MapTiler / MapLibre tile server (optional; OSM tiles used as fallback)
MAPTILER_API_KEY=

# ─── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
# Used by the WeatherAdapter. Falls back to mock data when absent.

# ─── Events ───────────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=
# Used by the EventAdapter. Falls back to seed/mock events when absent.

# ─── Deployment — Supabase / PostgreSQL ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only required in staging/production. Not used in local SQLite mode.

# ─── Frontend (Next.js public variables — MUST be NEXT_PUBLIC_ prefixed) ──────
# These are embedded at build time and visible to the browser.
# NEVER place secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend FastAPI base URL accessible from the browser.

NEXT_PUBLIC_APP_NAME=LocaLens
NEXT_PUBLIC_APP_VERSION=0.1.0
